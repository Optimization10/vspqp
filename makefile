#===============================================================================
# Main Makefile
#===============================================================================
VSPATH = $(realpath $(CURDIR))
export VSPATH

include $(VSPATH)/Config/internal.mk

.PHONY: lib example run_example valgrind clean callgrind

default: lib

lib: $(VSPQP_CONFIG_H)
	@mkdir -p $(VSPATH)/output $(BUILD_DIR)
	$(MAKE) -C $(VSPATH)/Lib


# To make a new example (such as Demo/X.c)
#    In the current makefile:
#    	1) Add X target to this file similar to the example target
#       2) and add X to .PHONY above
#    	3) Add rm -f lines for X and X.d in clean target
#       4) Add run_X target similar to run_example
#    
#	 In the demo makefile:
#	    1) Add X to .PHONY
#       2) Add X: $(VSPATH)/Demo/X
#       3) Add -include $(VSPATH)/Demo/X.d
example: $(VSPQP_CONFIG_H)
	$(MAKE) -C $(VSPATH)/Demo example





run_example: example
	@echo ""
	@echo "Running example...\n"
	@./Demo/example

valgrind: example
	@mkdir -p $(VSPATH)/output
	@valgrind \
	--tool=memcheck \
	--leak-check=full \
	--show-leak-kinds=all \
	--track-origins=yes \
	--suppressions=$(VSPATH)/Config/mkl.supp \
	--log-file=$(VSPATH)/output/valgrind.txt \
	./Demo/example

callgrind: example
	@mkdir -p $(VSPATH)/output/callgrind
	@echo ""
	@echo "Running callgrind with cache simulation..."
	@valgrind \
		--tool=callgrind \
		--cache-sim=yes \
		--callgrind-out-file=$(VSPATH)/output/callgrind/callgrind.out \
		./Demo/example
	@callgrind_annotate --threshold=99 \
		$(VSPATH)/output/callgrind/callgrind.out \
		> $(VSPATH)/output/callgrind/callgrind.txt
	@echo ""
	@echo "Output: $(VSPATH)/output/callgrind/callgrind.txt"
	@echo "        $(VSPATH)/output/callgrind/callgrind.out (open with kcachegrind)"

clean:
	rm -rf $(BUILD_DIR)
	rm -f $(LIB_VSPQP)
	rm -f $(VSPATH)/Demo/example
	rm -f $(VSPATH)/Demo/example.d
	rm -f $(VSPQP_CONFIG_H)
	rm -rf output/*


# =============================================================================
# Generate Config Header
# =============================================================================
$(VSPQP_CONFIG_H): $(VSPATH)/Config/user_config.mk
	@echo "Generating VSPQP_config.h..."
	@echo "/* Auto-generated by the build system. Do not edit. */" > $@
	@echo "#ifndef VSPQP_CONFIG_H" >> $@
	@echo "#define VSPQP_CONFIG_H" >> $@
	@echo "" >> $@
	@echo "#define VSPFLOAT $(RESOLVED_VSPFLOAT)" >> $@
	@echo "#define VSPINT $(RESOLVED_VSPINT)" >> $@
	@echo "#define VSPLONG $(RESOLVED_VSPLONG)" >> $@
	@echo "" >> $@
	@echo "#endif" >> $@