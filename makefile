### User #######################################################################
COMPILER = gcc
# COMPILER = clang

# Mode 0 --> VSPINT = int and VSPLONG = int (default)
# Mode 1 --> VSPINT = int and VSPLONG = long long
# Mode 2 --> VSPINT = long long and VSPLONG = long long
VSP_INTEGERS_MODE = 0
# WARNING: This is not fixed in SuiteSparse
# I really should just get rid of all the SuiteSparse stuff and make my own
# functions for reading and cleaning matrices

# Measure Performance
# 1 to enable, 0 to disable
MEASURE_PERFORMANCE = -DMEASURE_PERFORMANCE=1

# Possible commands
#     make                 = compile and run with debugging on $(DATA) graph
#     make performance     = compile and run with optimizations and no debugging
#     make log             = same as performance, except enable logging
#     make valgrind        = compile with debugging, and run valgrind
#     make profile         = compile with optimizations and profile
#     make test            = compile and solve all files in data/test with 
#     make clean           = delete all files generated by the program

### Internal ###################################################################



# Common flags
SOURCE     = $(shell find source -name '*.c')

HEADER_DIRS := $(sort $(dir $(shell find source include -name '*.h')))
INCLUDE     := -I. $(patsubst %,-I%,$(HEADER_DIRS)) -I ~/.local/include

LIBS       = -lm -lrt -L/home/ovi/.local/lib -lmetis -lGKlib
VSP_EXE    = build/vsp
COMMON_DEFINES = $(MEASURE_PERFORMANCE) $(PRINTING_FLAGS) \

# Debug flags
# IGNORE_WARNINGS =
IGNORE_WARNINGS = \
-Wno-unused-parameter \
-Wno-unused-variable \
-Wno-format \
-Wno-unused-but-set-variable \
-Wno-unused-function \
-Wno-switch

DBG_FLAGS       = -g3 -O0 -Wall  #-fsanitize=address
DBG_DEFS        = -DVSP_DEBUG
DBG_CRSNG_DEFS  = -DVSP_DEBUG_COARSENING

# Performance flags
PERF_FLAGS = -O3 -march=native -mtune=native

# Valgrind flags
VALGRIND_FLAGS = --log-file="output/VSP_valgrind_log.txt" --leak-check=full    \
                 --track-origins=yes                      --show-reachable=yes 

# Test flags
DATA = 
TEST_DATA = 

default: create_dirs
	@echo "Compiling..." ;
	@$(COMPILER) $(SOURCE)   -o$(VSP_EXE) $(INCLUDE) $(DBG_FLAGS) $(LIBS) \
	$(DBG_DEFS) $(COMMON_DEFINES) $(OTHER_FLAGS) -DVSP_LOG -DVSP_STATS \
	$(IGNORE_WARNINGS) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE) -Wl,--gc-sections
	@echo "Solving VSP..." ;
	@$(VSP_EXE) $(DATA)


# Build the executable in preparation for running the debugger in VS Code
vscode_dbg: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE)   -o$(VSP_EXE) $(INCLUDE) $(DBG_FLAGS) $(LIBS) -DVSP_DEBUG \
	$(COMMON_DEFINES) $(OTHER_FLAGS) $(IGNORE_WARNINGS) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "\n"

performance: create_dirs archive_output
	@echo "Compiling..." ;
	@$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) $(PERF_FLAGS) \
	-DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE) $(COMMON_DEFINES) -Wno-unused-result -g3
	@echo "Solving VSP..." ;
	@$(VSP_EXE) $(DATA)

buildPerformance: create_dirs archive_output
	@echo "Compiling..." ;
	@$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) $(PERF_FLAGS) $(COMMON_DEFINES) -Wno-unused-result -g3 \
	-DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Compilation finished" ;

runPerformance: create_dirs archive_output
	@echo "Solving VSP..." ;
	@$(VSP_EXE) $(DATA)


# Here, we may be using debugging symbols, we may enable optimzations, etc
performance_dbg: create_dirs archive_output
	@echo "Compiling..." ;
	@$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) -O0 $(COMMON_DEFINES) -g3 \
	-DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Solving VSP..." ;
	@$(VSP_EXE) $(DATA)
	@echo "\n"

# Here, we may be using debugging symbols, we may enable optimzations, etc
performance_dbg_sanitize: create_dirs archive_output
	@echo "Compiling..." ;
	@$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) -O0 $(COMMON_DEFINES) -g3 \
	-DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE) -fsanitize=address
	@echo "Solving VSP..." ;
	@$(VSP_EXE) $(DATA)
	@echo "\n"

valgrind: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE)   -o$(VSP_EXE) $(INCLUDE) $(DBG_FLAGS) $(LIBS)  $(DBG_DEFS) \
		$(OTHER_FLAGS) $(IGNORE_WARNINGS) -DVSP_LOG -DVSP_STATS -DMEASURE_PERFORMANCE=1 -DVSP_DEBUG -DVSP_DEBUG_COARSENING \
		-DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "\nRunning valgrind..."
	valgrind $(VALGRIND_FLAGS) ./build/vsp $(DATA)

valgrindcrs: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE)   -o$(VSP_EXE) $(INCLUDE) $(DBG_FLAGS) $(LIBS) \
        $(DBG_CRSNG_DEFS) $(DBG_DEFS) \
		$(OTHER_FLAGS) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "\nRunning valgrind..."
	valgrind $(VALGRIND_FLAGS) ./build/vsp $(DATA)


gprof_profile: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) -pg -g3 -O3 $(OTHER_FLAGS) $(COMMON_DEFINES) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Solving VSP..." ;
	$(VSP_EXE) $(DATA)
	mv gmon.out build/
	@echo "\nProfiling..." ;
	gprof build/vsp build/gmon.out > output/gprof_profile.txt


perf_profile: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) -g3 -O3 $(OTHER_FLAGS) $(COMMON_DEFINES) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Solving VSP..." ;
	$(VSP_EXE) $(DATA)
	sudo perf record $(VSP_EXE) $(DATA)
	perf report

valgrind_profile: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) -g3 -O3 $(OTHER_FLAGS) $(COMMON_DEFINES) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Solving VSP..." ;
	$(VSP_EXE) $(DATA)
	valgrind --tool=callgrind $(VSP_EXE) $(DATA)

test: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE)   -o$(VSP_EXE) $(INCLUDE) $(DBG_FLAGS) $(LIBS)  $(DBG_DEFS) $(COMMON_DEFINES) \
		$(OTHER_FLAGS) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Solving VSP..." ;
	$(VSP_EXE) $(TEST_DATA)


dbg_coarsening: create_dirs archive_output
	@echo "Compiling..." ;
	$(COMPILER) $(SOURCE)   -o$(VSP_EXE) $(INCLUDE) $(LIBS) $(DBG_FLAGS) $(DBG_DEFS) $(COMMON_DEFINES) \
		$(DBG_CRSNG_DEFS) $(OTHER_FLAGS) $(IGNORE_WARNINGS) -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Solving VSP..." ;
	$(VSP_EXE) $(DATA)


callgrind: create_dirs archive_output
	@echo "Compiling..." ;
	@$(COMPILER) $(SOURCE) -o$(VSP_EXE) $(INCLUDE) $(LIBS) $(PERF_FLAGS) $(COMMON_DEFINES) -fno-inline -Wno-unused-result -g3 -O0 -DVSP_INTEGERS_MODE=$(VSP_INTEGERS_MODE)
	@echo "Calling callgrind..." ;
	@valgrind --tool=callgrind --branch-sim=yes --cache-sim=yes --callgrind-out-file=./build/callgrind.out.%p ./$(VSP_EXE) $(DATA)
	@echo "Launching kcachegrind..." ;
	@kcachegrind ./build/callgrind.out.* &


archive_output:
	@if [ -n "$(shell ls -A output/ 2>/dev/null)" ]; then \
		TIMESTAMP=$$(date +%d-%b_%H-%M-%S_%Y); \
		mkdir -p outputs_archive/$$TIMESTAMP; \
		mv output/* outputs_archive/$$TIMESTAMP/; \
	else \
		echo "output/ is empty. Nothing to archive."; \
	fi

static_analysis: create_dirs
	clang --analyze -Xanalyzer -analyzer-output=html -Wall -Wextra $(INCLUDE) $(SOURCE) 

clean: create_dirs
	@echo "Cleaning output and build dirs..." ;
	@find output -type f -delete
	@find build -type f -delete
	rm *.zst

clean_archive: create_dirs
	@echo "Cleaning output, build, and outputs_archive dirs..." ;
	@find output -mindepth 1 -exec rm -rf {} +
	@find build -mindepth 1 -exec rm -rf {} +
	@find outputs_archive -mindepth 1 -exec rm -rf {} +


create_dirs:
	@mkdir -p build output