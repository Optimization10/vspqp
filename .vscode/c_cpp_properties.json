{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/**"
            ],
            "defines": [
                "TEMP",
                "DEBUG",
                "MIX",
                "STATS",
                "CLOCK_REALTIME",
                "MEASURE_PERFORMANCE",
                "PRINT_FLIP_INFO"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "-Iinclude",
                "-Isource"
            ]
        }
    ],
    "version": 4
}